APP_NAME=LoveyDovey
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
# "sync" sends queued mail/notifications immediately in the same request —
# no `php artisan queue:work` needed. Switch to "database" (and run a queue
# worker) once you're ready to send mail in the background at scale.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=sendlib
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@loveydovey.app"
MAIL_FROM_NAME="${APP_NAME}"
# Sendlib (https://sendlib.samueltuoyo.com/docs/send) — used by the "sendlib" mailer above
SENDLIB_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
SANCTUM_STATELESS_DOMAINS=localhost:5173
SESSION_DOMAIN=localhost
FRONTEND_URL=http://localhost:5173
OPENAI_API_KEY="your-openai-api-key"
# Note: BROADCAST_CONNECTION (set above, near SESSION_*) is what actually
# selects the broadcaster in this Laravel version — BROADCAST_DRIVER is a
# pre-Laravel-11 name and is not read by config/broadcasting.php.
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_APP_KEY="your-pusher-app-key"
PUSHER_APP_SECRET="your-pusher-app-secret"
PUSHER_APP_CLUSTER="your-pusher-app-cluster"
PUSHER_SCHEME="https"
